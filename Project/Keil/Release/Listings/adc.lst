 134          /**
 135           * @brief 控制adc通道切换的函数（由于adc通道切换后要等待稳定，这里改成非阻塞
             -延时的方式：定时调用通道切换+中断获取ad值）
 136           *
 137           * @note 1ms调用一次，每次在函数内切换通道->开启转换->切换通道->开启转换->...
 138           *
 139           * @return * void
 140           */
 141          void adc_channel_handle(void)
 142          {
 143   1      
 144   1          if (adc_status == ADC_STATUS_SEL_FUEL_END ||
 145   1              adc_status == ADC_STATUS_NONE)
 146   1          {
 147   2              adc_sel_pin(ADC_PIN_BATTERY);
 148   2              adc_status = ADC_STATUS_SEL_BATTERY_BEGIN;
 149   2          }
 150   1          else if (adc_status == ADC_STATUS_SEL_BATTERY_BEGIN)
 151   1          {
 152   2              ADC_CFG0 |= ADC_CHAN0_TRG(0x1); // 触发ADC0转换
 153   2              adc_status = ADC_STATUS_SEL_BATTERY_END;
 154   2          }
 155   1          else if (adc_status == ADC_STATUS_SEL_BATTERY_END)
 156   1          {
 157   2              adc_sel_pin(ADC_PIN_KEY);
 158   2              adc_status = ADC_STATUS_SEL_AD_KEY_BEGIN;
 159   2          }
 160   1          else if (adc_status == ADC_STATUS_SEL_AD_KEY_BEGIN)
 161   1          {
 162   2              ADC_CFG0 |= ADC_CHAN0_TRG(0x1); // 触发ADC0转换
 163   2              adc_status = ADC_STATUS_SEL_AD_KEY_END;
 164   2          }
 165   1          else if (adc_status == ADC_STATUS_SEL_AD_KEY_END)
 166   1          {
C51 COMPILER V9.60.7.0   ADC                                                               01/23/2026 09:33:09 PAGE 4   

 167   2              adc_sel_pin(ADC_PIN_FUEL);
 168   2              adc_status = ADC_STATUS_SEL_FUEL_BEGIN;
 169   2          }
 170   1          else if (adc_status == ADC_STATUS_SEL_FUEL_BEGIN)
 171   1          {
