 177          void ADC_IRQHandler(void) interrupt ADC_IRQn
 178          {
 179   1          u16 adc_val; // 由后续赋值
 180   1      
 181   1          // 进入中断设置IP，不可删除
 182   1          __IRQnIPnPush(ADC_IRQn);
 183   1      
 184   1          // ---------------- 用户函数处理 -------------------
 185   1      
 186   1          if (ADC_STA & ADC_CHAN0_DONE(0x01))
 187   1          {
 188   2              ADC_STA |= ADC_CHAN0_DONE(0x01);                 // 清除ADC0转换完成标志位
 189   2              adc_val = (ADC_DATAH0 << 4) | (ADC_DATAL0 >> 4); // 读取ADC0的值
 190   2      
 191   2              if (adc_status == ADC_STATUS_SEL_BATTERY_END)
 192   2              {
 193   3                  adc_update_battery_val(adc_val);
 194   3              }
 195   2              else if (adc_status == ADC_STATUS_SEL_AD_KEY_END)
 196   2              {
 197   3                  adc_update_ad_key_val(adc_val);
 198   3              }
 199   2              else if (adc_status == ADC_STATUS_SEL_FUEL_END)
 200   2              {
 201   3                  adc_update_fuel_val(adc_val);
 202   3              }
 203   2          }
 204   1      
 205   1          // 退出中断设置IP，不可删除
 206   1          __IRQnIPnPop(ADC_IRQn);
 207   1      }
