  26          u16 conver_adc_val_to_voltage(u16 arg_adc_val)
  27          {
  28   1          /*
  29   1              采集到的ad值范围：0~4095
  30   1              ad值对应的电压： 0 ~ MAX_VOLTAGE_OF_BATTERY
  31   1              那么 每单位ad值对应 MAX_VOLTAGE_OF_BATTERY / 4096
  32   1          */
  33   1          // return (u32)arg_adc_val * MAX_VOLTAGE_OF_BATTERY / 4096;
  34   1      
  35   1          // 使用2.4V参考电压，12位精度
  36   1          // 电池电压是 1/11 分压：
  37   1          return (u32)arg_adc_val * 240 * 11 / 10 / 4096;
  38   1      }
  39          
  40          // 将电池电压转换为对应的百分比
  41          // voltage： 0~255 ， 对应0~25.5V
  42          // 例如 voltage == 140，对应14.0V
  43          u8 conver_voltage_of_battery_to_percentage(u8 voltage)
  44          {
  45   1          u8 tmp;
  46   1      
  47   1          // 客户要求，如果检测到大于15V，就认为满电
  48   1          if (voltage >= 150)
  49   1          {
  50   2              tmp = 100;
  51   2          }
  52   1          else
  53   1          {
C51 COMPILER V9.60.7.0   BATTERY                                                           01/23/2026 09:33:11 PAGE 2   

  54   2              // 如果电压小于15V，根据公式来得到百分比
  55   2              // 用电池电压voltage除以MAX_VOLTAGE_OF_BATTERY，得到占比，再乘以100，得到百分
             -比
  56   2              tmp = (u16)voltage * 100 / MAX_VOLTAGE_OF_BATTERY;
  57   2          }
  58   1      
  59   1          return tmp;
  60   1      }
