 133          // 将油量百分比转换成油量挡位
 134          u8 convert_fuel_percent_to_gear(u8 fuel_percent)
 135          {
 136   1          u8 fuel_gear = 0;
 137   1          if (0 == fuel_percent)
 138   1          {
 139   2              fuel_gear = 0;
 140   2          }
 141   1          else if (fuel_percent >= 1 && fuel_percent <= 17)
 142   1          {
 143   2              fuel_gear = 1;
 144   2          }
 145   1          else if (fuel_percent >= 18 && fuel_percent <= 33)
 146   1          {
 147   2              fuel_gear = 2;
 148   2          }
 149   1          else if (fuel_percent >= 34 && fuel_percent <= 50)
 150   1          {
 151   2              fuel_gear = 3;
 152   2          }
 153   1          else if (fuel_percent >= 51 && fuel_percent <= 67)
 154   1          {
 155   2              fuel_gear = 4;
 156   2          }
 157   1          else if (fuel_percent >= 68 && fuel_percent <= 83)
 158   1          {
 159   2              fuel_gear = 5;
 160   2          }
 161   1          // else if (fuel_percent >= 84)
 162   1          else
 163   1          {
 164   2              fuel_gear = 6;
 165   2          }
 166   1      
 167   1          return fuel_gear;
 168   1      }
