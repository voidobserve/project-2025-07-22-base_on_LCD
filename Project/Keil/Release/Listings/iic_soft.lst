 359          /**
 360           * @brief  wait ack function
 361           * @param  None
 362           * @retval 1:no ack 0:ack
 363           */
 364          u8 iic_wait_ack(void)
 365          {
 366   1          u8 timeout = 0;
 367   1      
 368   1          SDA_IN(); // SDA设置为输入
 369   1      
 370   1          // 配置为高电平
 371   1          IIC_SDA = 1;
 372   1          IIC_DELAY();
 373   1      
 374   1          // 配置为高电平
 375   1          IIC_SCL = 1;
 376   1          IIC_DELAY();
 377   1      
 378   1          while (IIC_SDA)
 379   1          {
 380   2              // 等待SDA拉低，表示应答带来，不然一直while循环，直到超时
 381   2              timeout++;
 382   2              if (timeout > 250)
 383   2              {
 384   3                  iic_stop(); // 等待超时，应答失败，发出停止信号
 385   3                  return 1;   // 返回1，表示失败
 386   3              }
 387   2              IIC_DELAY();
 388   2          }
 389   1          IIC_SCL = 0; // SCL拉低
 390   1      
 391   1          return 0; // 返回0，表示成功
 392   1      }
