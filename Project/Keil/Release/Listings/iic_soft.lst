 401   1          IIC_SCL = 0;
 402   1          SDA_OUT();
 403   1          IIC_SDA = 0;
 404   1          IIC_DELAY();
 405   1          IIC_SCL = 1;
 406   1          IIC_DELAY();
 407   1          IIC_SCL = 0;
