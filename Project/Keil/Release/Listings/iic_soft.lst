 316          /**
 317           * @brief  iic start function
 318           * @param  None
 319           * @retval None
 320           */
 321          void iic_start(void)
 322          {
 323   1          // 起始时，系统时钟线（SCLK）和系统数据线（SDATA）都处于高电平
 324   1          SDA_OUT(); // SDA线输出
 325   1          IIC_SDA = 1;
 326   1          IIC_SCL = 1;
 327   1          // 延时函数是为了等待配置完成，当SCLK为高电平时，SDATA跳变为低电平
 328   1          // 紧接着SCLK也跳变为低电平
 329   1          // 产生一个起始信号
 330   1          IIC_DELAY();
 331   1          IIC_SDA = 0; // START:when CLK is high,DATA change form high to low
 332   1          IIC_DELAY();
 333   1          IIC_SCL = 0;
 334   1      }
 335          
 336          /**
 337           * @brief  iic stop function
 338           * @param  None
 339           * @retval None
 340           */
 341          void iic_stop(void)
 342          {
 343   1          SDA_OUT(); // SDA线输出
 344   1      
 345   1          // 配置时钟线和数据线均为低电平
 346   1          IIC_SCL = 0;
C51 COMPILER V9.60.7.0   IIC_SOFT                                                          11/25/2025 15:26:54 PAGE 7   

 347   1          IIC_SDA = 0; // STOP:when CLK is high DATA change form low to high
 348   1          IIC_DELAY();
 349   1      
 350   1          // 配置时钟线为高电平
 351   1          IIC_SCL = 1;
 352   1          IIC_DELAY();
 353   1      
 354   1          // 在时钟线为高电平时，输出的数据线从低电平跳变到高电平，则产生了停止
             -信号
 355   1          IIC_SDA = 1;
 356   1          IIC_DELAY();
 357   1      }
