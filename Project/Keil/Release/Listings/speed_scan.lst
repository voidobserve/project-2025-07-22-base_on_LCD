 125          void speed_buff_update(u16 speed)
 126          {
 127   1          static u16 last_speed;       // 存放上一次采集到的速度
 128   1          u16 speed_difference = 0;    // 存放速度的差值
 129   1          bit dir_of_speed_change = 0; // 速度变化的方向，0--速度变小，1--速度变大
 130   1          u8 i;                        // 循环计数值（由下面的语句赋值，这里为了节省程序�
             -��间，没有给初始值）
 131   1      
 132   1          if (speed > last_speed)
 133   1          {
 134   2              // 如果当前的速度 大于 上一次采集到的速度
 135   2              speed_difference = speed - last_speed;
 136   2              dir_of_speed_change = 1; // 表示速度变大
 137   2          }
 138   1          else if (speed < last_speed)
 139   1          {
 140   2              // 如果当前的速度 小于 上一次采集到的速度
 141   2              speed_difference = last_speed - speed;
 142   2              dir_of_speed_change = 0; // 表示速度变小
 143   2          }
 144   1          else
 145   1          {
 146   2              for (i = 0; i < SPEED_SCAN_BUFF_SIZE; i++)
 147   2              {
 148   3                  speed_buff[i] = speed;
 149   3              }
 150   2      
 151   2              // // 没有差值，直接更新（修复没有差值且数值为0时，没有发送数据的问�
             -��）
 152   2              // fun_info.speed = speed;
 153   2              // flag_get_engine_speed = 1;
 154   2      
 155   2              cur_send_speed_buff_index = 0; // 游标复位
 156   2              return;
 157   2          }
 158   1      
 159   1          if (dir_of_speed_change)
 160   1          {
 161   2              // 如果速度在变大，数组从 [0] ~ [SPEED_SCAN_BUFF_SIZE - 1] 数值越来越大
 162   2              for (i = 0; i < SPEED_SCAN_BUFF_SIZE; i++)
 163   2              {
 164   3                  speed_buff[i] = speed_difference * (i + 1) / SPEED_SCAN_BUFF_SIZE + last_speed;
 165   3              }
